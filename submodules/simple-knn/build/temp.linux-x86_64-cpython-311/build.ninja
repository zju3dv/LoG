ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /root/miniconda3/envs/alog/compiler_compat -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /root/miniconda3/envs/alog/include -fPIC -O2 -isystem /root/miniconda3/envs/alog/include -fPIC -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include/TH -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include/THC -I/usr/local/cuda/include -I/root/miniconda3/envs/alog/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include/TH -I/root/miniconda3/envs/alog/lib/python3.11/site-packages/torch/include/THC -I/usr/local/cuda/include -I/root/miniconda3/envs/alog/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /root/repository/project/sci/test_l,og$ (copy)/LoG/submodules/simple-knn/build/temp.linux-x86_64-cpython-311/ext.o: compile /root/repository/project/sci/test_l,og$ (copy)/LoG/submodules/simple-knn/ext.cpp
build /root/repository/project/sci/test_l,og$ (copy)/LoG/submodules/simple-knn/build/temp.linux-x86_64-cpython-311/simple_knn.o: cuda_compile /root/repository/project/sci/test_l,og$ (copy)/LoG/submodules/simple-knn/simple_knn.cu
build /root/repository/project/sci/test_l,og$ (copy)/LoG/submodules/simple-knn/build/temp.linux-x86_64-cpython-311/spatial.o: cuda_compile /root/repository/project/sci/test_l,og$ (copy)/LoG/submodules/simple-knn/spatial.cu






